---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProcessStory from '../components/ProcessStory.astro';
import OptionalContent from '../components/OptionalContent.astro';
import BookingRequest from '../components/BookingRequest.astro';
import ChatConcierge from '../components/ChatConcierge.astro';
import MotionExperience from '../components/MotionExperience.astro';
import PricingTeaser from '../components/PricingTeaser.astro';
import { env } from 'cloudflare:workers';
import { approvedReviews, siteConfig } from '../data/site';
import { pricingDraft } from '../data/pricing';

const service = siteConfig.services[0];
const chatEnabled = Boolean(env.OPENAI_API_KEY && env.CHAT_RATE_SALT);
---

<BaseLayout site={siteConfig}>
  <div id="top" class="page-shell">
    <Header site={siteConfig} />
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy reveal">
          <p class="eyebrow">Scarborough nail studio · By appointment</p>
          <h1 id="hero-title">Dreamy nails <em>await.</em></h1>
          <p class="hero__intro">Get cosy in Bianca’s home studio for a one-on-one dry combi manicure with precise cuticle work and structure built around your natural nails.</p>
          <ul class="hero__areas" aria-label="Clients welcome from"><li>Scarborough</li><li>Pickering</li><li>Ajax</li><li>Whitby</li><li>Durham Region</li><li>Greater Toronto Area</li></ul>
          <div class="hero__actions">
            <a class="button" href="#booking" data-analytics-events="booking_request_view">Request an appointment</a>
            <a class="text-link" href="/services-pricing">See services &amp; prices <span aria-hidden="true">↘</span></a>
          </div>
        </div>
        <figure class="hero__media reveal">
          <video class="hero__video" controls muted playsinline loop preload="none" poster="/videos/long-gel-x-poster.webp" width="720" height="1280" aria-labelledby="hero-video-caption">
            <source src="/videos/long-gel-x.mp4" type="video/mp4" />
          </video>
          <figcaption id="hero-video-caption">Long Gel-X with Manicure</figcaption>
        </figure>
      </section>

      <div class="brand-marquee" data-marquee>
        <span class="sr-only">OOO looks good on you</span>
        <div class="brand-marquee__track" aria-hidden="true">
          {[0, 1].map(() => <div class="brand-marquee__group">
            {[0, 1, 2].map(() => <><span>OOO looks good on you</span><img src="/brand/submark.svg" alt="" /></>)}
          </div>)}
        </div>
        <button class="brand-marquee__pause" type="button" aria-label="Pause scrolling banner" aria-pressed="false" data-marquee-toggle><span aria-hidden="true">Ⅱ</span></button>
      </div>

      <section class="about section" id="about" aria-labelledby="about-title">
        <div class="about__body reveal">
          <p class="eyebrow">Nail manicurist in Scarborough</p>
          <h2 id="about-title">Meet <em>Bianca :)</em></h2>
          <p>I’m Bianca, a certified nail technician and the owner of La La Land Nail Hub, my home studio in Scarborough. What I enjoy most about doing nails is figuring out what works for each person. I see one client at a time, so we can talk about what you like, what’s worked for you before, and what you’d like to change.</p>
          <p>I specialize in dry combi manicures and structured gel. If you want to keep your nails short, grow out your natural length, or find a shape that suits your hands, I can help. I take care with prep and build the gel around the natural curve of your nails, adding support where they need it.</p>
          <a class="text-link" href="#booking">Request an appointment <span aria-hidden="true">↗</span></a>
          {siteConfig.provider.credentials.length > 0 && (
            <ul class="about__credentials">
              {siteConfig.provider.credentials.map((credential) => <li>{credential}</li>)}
            </ul>
          )}
        </div>
        <img class="about__portrait" src="/images/bianca-ashley.webp" width="900" height="1200" alt="Bianca Ashley" loading="lazy" decoding="async" />
      </section>

      <section class="service section" id="service" aria-labelledby="service-title">
        <div class="section-heading reveal">
          <p class="eyebrow">Dry manicure · Gel colour · Structured gel · Soft gel tips</p>
          <h2 id="service-title">Before You Book / <em>Policies</em></h2>
          <figure class="section-photo section-photo--wide">
            <div class="section-photo__frame manicure-comparison__frame" id="manicure-comparison">
              <img class="manicure-comparison__after" src="/images/red-manicure-1440.webp" srcset="/images/red-manicure-720.webp 720w, /images/red-manicure-1440.webp 1440w" sizes="(max-width: 900px) 90vw, 660px" width="1440" height="1080" alt="Glossy deep-red polish on short square nails" loading="lazy" decoding="async" />
              <img class="manicure-comparison__before" src="/images/red-manicure-before.webp" width="942" height="665" alt="Short bare nails before the manicure" loading="lazy" decoding="async" />
              <span class="manicure-comparison__tag manicure-comparison__tag--before" aria-hidden="true">Before</span>
              <span class="manicure-comparison__tag manicure-comparison__tag--after" aria-hidden="true">After</span>
              <span class="manicure-comparison__divider" aria-hidden="true"></span>
            </div>
            <figcaption>
              <label for="manicure-reveal">Slide to compare the manicure</label>
              <input class="manicure-comparison__range" id="manicure-reveal" type="range" min="0" max="100" value="50" aria-controls="manicure-comparison" aria-valuetext="50% before, 50% after" />
            </figcaption>
          </figure>
          <dl class="service__facts">
            <div><dt>Specialty</dt><dd>{siteConfig.specialty}</dd></div>
            <div><dt>Availability</dt><dd>{service.availability}</dd></div>
            {service.duration && <div><dt>Duration</dt><dd>{service.duration}</dd></div>}
          </dl>
        </div>
        <div class="service__content reveal">
          <p class="service__lead">Take a little time for yourself with a one-on-one European-style dry manicure. Each appointment starts with detailed cuticle care and shaping that follows the natural curve of your nails.</p>
          <img class="service__feature-photo" src="/images/olive-cat-eye-manicure.webp" width="1122" height="1402" alt="Olive-gold cat-eye manicure on green fabric" loading="lazy" decoding="async" />
          <div class="service__decision">
            <p>From there, you can keep your nails bare, add gel colour, or go with a structured gel overlay for a little extra support. If you’d like more length, soft gel extensions are an option too.</p>
            <p>If you’ve been in before, you can come back for a fill, a little upkeep, or a nail repair.</p>
            <p>New here and wearing gel from another nail tech? Please arrive with bare nails or book a removal with your manicure. A fresh set starts on bare nails, so please mention the existing gel in your booking request so extra time can be set aside for removal.</p>
            <a class="button button--cream" href="/services-pricing">Compare services &amp; pricing</a>
            <a class="text-link" href="#booking" data-analytics-events="booking_request_view">Request an appointment <span aria-hidden="true">↗</span></a>
          </div>
          <div class="service__detail-list">
            <h3>Deposits and cancellations</h3>
            <p>A $30 deposit secures your booking and goes toward the cost of your appointment. If you need to cancel, please give at least 24 hours’ notice. The deposit is non-refundable if you cancel less than 24 hours before your appointment.</p>
          </div>
        </div>
      </section>

      {(import.meta.env.DEV || pricingDraft.approved) && <PricingTeaser />}

      <ProcessStory steps={siteConfig.process} />


      <OptionalContent
        gallery={siteConfig.gallery}
        reviews={approvedReviews}
        faqs={siteConfig.faqs}
        policies={siteConfig.policies}
      />

      <BookingRequest />
    </main>
    <Footer site={siteConfig} />
    {chatEnabled && <ChatConcierge />}
    <MotionExperience />
  </div>

</BaseLayout>

<script>
  const comparison = document.querySelector<HTMLElement>('#manicure-comparison');
  const reveal = document.querySelector<HTMLInputElement>('#manicure-reveal');
  if (comparison && reveal) {
    const updateComparison = () => {
      comparison.style.setProperty('--reveal', `${reveal.value}%`);
      reveal.setAttribute('aria-valuetext', `${reveal.value}% before, ${100 - reveal.valueAsNumber}% after`);
    };
    reveal.addEventListener('input', updateComparison);
    updateComparison();
  }

  const heroVideo = document.querySelector<HTMLVideoElement>('.hero__video');
  if (heroVideo && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    // Keep the poster and native play button if the browser blocks autoplay.
    void heroVideo.play().catch(() => {});
  }

  const marquee = document.querySelector('[data-marquee]');
  const pause = document.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  pause?.addEventListener('click', () => {
    const paused = marquee?.classList.toggle('is-paused') ?? false;
    pause.setAttribute('aria-pressed', String(paused));
    pause.setAttribute('aria-label', paused ? 'Resume scrolling banner' : 'Pause scrolling banner');
    pause.innerHTML = `<span aria-hidden="true">${paused ? '▶' : 'Ⅱ'}</span>`;
  });
</script>
