---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { siteConfig as site } from '../../data/site';
import { guides } from '../../data/service-guides';
import { pricingDraft } from '../../data/pricing';
import { serializeSchema } from '../../lib/seo';
const guide = guides.find(g => g.path === '/services/' + Astro.params.slug);
if (!guide || !pricingDraft.approved) return new Response('Page not found', {status:404});
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services & pricing', path: '/services-pricing' }, { name: guide.label, path: guide.path }];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, index) => ({
    '@type': 'ListItem', position: index + 1, name: crumb.name,
    item: new URL(crumb.path, site.approvedDomain ?? site.canonicalOrigin).href
  }))
};
---
<BaseLayout site={site} title={guide.seoTitle ?? guide.title + ' | La La Land Nail Hub'} description={guide.description} photo={guide}>
<div class="page-shell" id="top"><Header site={site}/>
<main id="main"><article>
<script type="application/ld+json" is:inline set:html={serializeSchema(breadcrumbSchema)} />
<header class="intro"><div><nav class="crumbs" aria-label="Breadcrumb"><ol>{crumbs.map((crumb,i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{crumb.name}</span> : <a href={crumb.path}>{crumb.name}</a>}</li>)}</ol></nav><h1>{guide.title}</h1><p>{guide.intro}</p></div><img src={guide.img} alt={guide.alt} fetchpriority="high"/></header>
<div class="details">
{guide.id === 'structured' && <section><h2>Rubber base or builder gel?</h2>
<p>To keep your current length with a flexible base and gel colour, choose <a href="/?service=rubber-base#booking">rubber base with gel colour · $65 CAD</a>. For a shaped overlay that supports your natural nails as they grow, choose <a href="/?service=structured#booking">structured builder gel · from $75 CAD</a>.</p>
<p>Want longer nails at this visit? <a href="/services/soft-gel-tips-scarborough">Soft gel tips start at $65 CAD</a> and extend past your fingertips.</p></section>}
{guide.id === 'gel-removal' && <section><h2>Going bare or booking a fresh manicure?</h2><p><a href="/?service=removal#booking">Request standalone removal · $25 CAD</a> for removal and basic shaping. For a fresh set, <a href="/services-pricing#manicures">choose your manicure</a> and mention your current gel in the request so Bianca can allow time for removal.</p></section>}
{guide.id === 'nail-art' && <section><h2>Two finishes for short square nails</h2>
<figure><img src="/images/red-manicure-720.webp" alt="Short square nails with glossy red gel colour" loading="lazy" /><figcaption>For this solid red look, request the <a href="/services/gel-manicure-scarborough">$60 CAD gel manicure</a>. Solid colour is included.</figcaption></figure>
<figure><img src="/images/structured-pink-french.webp" alt="Soft pink square nails with white French tips" loading="lazy" /><figcaption>For this French finish on short natural nails, request <a href="/services/structured-gel-scarborough">structured gel from $75 CAD</a> with elevated nail art (+$20 CAD). The starting estimate is $95 CAD.</figcaption></figure></section>}
{guide.questions.map(({q,a}) => <section><h2>{q}</h2><p>{guide.id === 'structured' && a.includes('request a structured gel fill') ? <>{a.split('request a structured gel fill')[0]}request a <a href="/services/structured-gel-fills-scarborough">structured gel fill</a>{a.split('request a structured gel fill')[1]}</> : a}</p></section>)}
{!['structured-gel-fills', 'gel-removal'].includes(guide.id) && <section><h2>Coming in with gel from another technician?</h2><p>Please arrive with bare nails or <a href="/services/gel-removal-scarborough">book removal with your manicure</a>. Mention your existing product when booking so I can set aside time at my Scarborough studio.</p></section>}
<a class="button" href={['structured', 'dry', 'soft-gel-tips', 'gel-colour'].includes(guide.id) ? "/?service=" + guide.id + "#booking" : "/#booking"}>Request an appointment</a>
<nav aria-label="Compare manicure services">{guides.filter(g=>g.id!==guide.id).map(g=><a href={g.path}>{g.label}</a>)}</nav></div>
</article></main><Footer site={site}/></div></BaseLayout>
<style>
.crumbs ol { display:flex; flex-wrap:wrap; gap:.45em; padding:0; list-style:none; }
.crumbs li + li::before { content:"/"; margin-right:.45em; }
.details figure {margin:1.5rem 0}.details figure img {width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:1rem}.details figcaption {margin-top:.5rem}.details figcaption a,.details p a { text-decoration:underline; }

.intro{background:#330505;color:#fff0cb;display:grid;grid-template-columns:1fr 1fr;gap:5vw;align-items:center;padding:9rem 5vw 4rem}.intro h1{font-size:clamp(2.8rem,5vw,5.5rem);line-height:1.05;margin:1.2rem 0}.intro img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:1rem}.details{max-width:48rem;margin:auto;padding:3rem 1.25rem}.details section{margin-bottom:2rem}.details h2{font-size:clamp(1.6rem,3vw,2.4rem)}p{line-height:1.65}.details nav{display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:2rem}nav a,.intro a{text-decoration:underline}@media(max-width:800px){.intro{grid-template-columns:1fr;padding-top:9rem}}
</style>
