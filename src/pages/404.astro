---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout site={siteConfig} title="Page not found | La La Land Nail Hub">
  <main id="main" class="not-found">
    <BrandLogo />
    <p class="eyebrow">404</p>
    <h1>We couldn’t find that page.</h1>
    <p>Find manicure services, compare prices or request an appointment from our homepage.</p>
    <a class="button button--cream" href="/">Go to the homepage</a>
    <a class="text-link" href="/services-pricing">View services &amp; pricing</a>
  </main>
</BaseLayout>
