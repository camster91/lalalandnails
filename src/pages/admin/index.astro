---
import '../../styles/global.css';
import StudioApp from '../../components/StudioApp.astro';
import { getStaffAccess, privateHeaders } from '../../lib/auth';
export const prerender=false;
Object.entries(privateHeaders).forEach(([name,value])=>Astro.response.headers.set(name,value));
const access=await getStaffAccess(Astro.request);
if(!access.configured)Astro.response.status=503;
else if(!access.user)Astro.response.status=401;
---
<!doctype html><html lang="en-CA"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><meta name="referrer" content="no-referrer"/><link rel="icon" href="/brand/submark.svg" type="image/svg+xml"/><title>Studio workspace | La La Land Nail Hub</title></head>
<body class="studio-body">{access.user ? <StudioApp/> : <main class="studio-denied"><p>La La Land Nail Hub</p><h1>Staff sign-in required</h1><p>{access.configured?'Sign in with an approved staff account through Cloudflare Access.':'The workspace is locked until secure staff sign-in is configured.'}</p><a href="/">Return to website</a></main>}</body></html>
