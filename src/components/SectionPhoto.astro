---
import { imagery } from '../data/imagery';

interface Props {
  photo: 'colour' | 'neutral' | 'detail' | 'care' | 'red';
  caption: string;
  aspect?: 'wide' | 'portrait';
}

const { photo, caption, aspect } = Astro.props;
const image = imagery[photo];
---

<figure class:list={['section-photo', aspect && `section-photo--${aspect}`]}>
  <div class="section-photo__frame">
    <img src={`/images/generated/${image.id}-1440.webp`} srcset={`/images/generated/${image.id}-720.webp 720w, /images/generated/${image.id}-1440.webp 1440w`} sizes="(max-width: 900px) 90vw, 660px" width={image.width} height={image.height} alt={image.alt} loading="lazy" decoding="async" />
  </div>
  <figcaption>{caption} <span>AI-generated inspiration.</span></figcaption>
</figure>
