---
interface Props {
  tier: 1 | 2 | 3 | 4;
}
const { tier } = Astro.props;
---
<svg class="nail-art-illustration" viewBox="0 0 360 170" aria-hidden="true" focusable="false">
  <rect width="360" height="170" rx="18" fill="#fffaf5"/>
  <g fill="#eec9cc" stroke="#7d395d" stroke-width="1.3">
    <rect x="31" y="17" width="72" height="132" rx="33"/>
    <rect x="143" y="17" width="72" height="132" rx="33"/>
    <rect x="255" y="17" width="72" height="132" rx="33"/>
  </g>
  <g fill="none" stroke="#fff9fa" stroke-width="5" opacity=".8" stroke-linecap="round">
    <path d="M46 43 V94"/>
    <path d="M158 43 V94"/>
    <path d="M270 43 V94"/>
  </g>
  {tier === 1 && (
    <g fill="#7d395d">
      <circle cx="67" cy="74" r="4"/>
      <circle cx="67" cy="89" r="4"/>
      <path d="M167 75 C167 67 177 67 179 74 C184 67 194 67 194 75 C194 84 180 93 180 93 C180 93 167 84 167 75Z"/>
      <circle cx="291" cy="69" r="3.5"/>
      <circle cx="291" cy="83" r="3.5"/>
      <circle cx="291" cy="97" r="3.5"/>
    </g>
  )}
  {tier === 2 && (
    <g fill="none" stroke="#7d395d" stroke-linecap="round">
      <path d="M39 53 Q67 26 95 53" stroke-width="7"/>
      <path d="M151 75 C171 54 192 92 207 67 M157 98 C179 115 194 89 201 92" stroke-width="3.8"/>
      <path d="M263 52 Q290 25 319 52 M265 64 Q291 40 317 64" stroke-width="4"/>
      <path d="M286 102 C286 92 297 92 297 102 C306 98 310 109 300 114 C306 122 296 128 289 121 C278 130 267 116 277 110 C268 103 278 93 286 102Z" fill="#fff0c8" stroke-width="2"/>
    </g>
  )}
  {tier === 3 && (
    <>
      <ellipse cx="67" cy="82" rx="20" ry="30" fill="#a6507b" opacity=".24"/>
      <ellipse cx="67" cy="82" rx="11" ry="18" fill="#914565" opacity=".4"/>
      <g fill="#8d5a40" opacity=".9">
        <path d="M158 55 Q164 47 176 57 L170 72 L157 68Z"/>
        <path d="M188 85 L200 79 L205 100 L193 110 L186 99Z"/>
        <path d="M156 112 L171 104 L184 113 L174 125 L159 123Z"/>
        <path d="M185 43 L196 51 L188 63 L178 56Z"/>
      </g>
      <g fill="#fff0c8" stroke="#7d395d" stroke-width="1.8">
        <ellipse cx="292" cy="83" rx="9" ry="19"/>
        <ellipse cx="292" cy="83" rx="9" ry="19" transform="rotate(60 292 83)"/>
        <ellipse cx="292" cy="83" rx="9" ry="19" transform="rotate(120 292 83)"/>
        <circle cx="292" cy="83" r="6" fill="#a6507b"/>
      </g>
    </>
  )}
  {tier === 4 && (
    <>
      <g fill="none" stroke="#7d395d" stroke-width="3" stroke-linecap="round">
        <path d="M45 113 C84 102 50 63 81 52 C101 46 90 87 70 80"/>
        <path d="M158 48 C197 48 152 117 204 111"/>
        <path d="M277 50 C304 59 281 98 316 114"/>
      </g>
      <g fill="#fff0c8" stroke="#7d395d" stroke-width="1.5">
        <ellipse cx="180" cy="87" rx="8" ry="19"/>
        <ellipse cx="180" cy="87" rx="8" ry="19" transform="rotate(60 180 87)"/>
        <ellipse cx="180" cy="87" rx="8" ry="19" transform="rotate(120 180 87)"/>
        <circle cx="180" cy="87" r="5" fill="#7d395d"/>
      </g>
      <g fill="#ffffff" stroke="#7d395d" stroke-width="1.4">
        <path d="M65 49 L70 59 L65 69 L60 59Z"/>
        <path d="M293 86 L302 103 L293 120 L284 103Z"/>
      </g>
      <g fill="#7d395d">
        <circle cx="55" cy="85" r="2"/>
        <circle cx="83" cy="99" r="2"/>
        <circle cx="171" cy="62" r="2"/>
        <circle cx="191" cy="123" r="2"/>
        <circle cx="309" cy="68" r="2"/>
      </g>
    </>
  )}
</svg>
<style>
  .nail-art-illustration { display: block; width: 100%; height: auto; border-radius: 1rem; }
</style>
