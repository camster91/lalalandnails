<script>
  async function initialiseMotion() {
    let media: ReturnType<(typeof import('gsap'))['gsap']['matchMedia']> | undefined;
    try {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'), import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);
      media = gsap.matchMedia();
      media.add({
        all: '(min-width: 0px)',
        reduced: '(prefers-reduced-motion: reduce)',
        desktop: '(min-width: 901px)',
      }, (context) => {
        const { reduced, desktop } = context.conditions ?? {};
        if (reduced) return;

        // Columns enter together and settle on their shared grid lines.
        // No initial hiding: import failure leaves all content visible.
        const groups = new Map<HTMLElement, HTMLElement[]>();
        document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => {
          const parent = element.parentElement;
          if (!parent || parent.closest('.reveal')) return;
          const group = groups.get(parent) ?? [];
          group.push(element);
          groups.set(parent, group);
        });
        groups.forEach((elements, parent) => {
          gsap.fromTo(elements, { opacity: .5, y: desktop ? 24 : 14 }, {
            opacity: 1, y: 0, duration: .75, ease: 'power2.out',
            stagger: parent.matches('section') ? 0 : .08,
            immediateRender: false,
            scrollTrigger: { trigger: parent, start: 'top 88%', once: true },
          });
        });

        document.querySelectorAll<HTMLElement>('.service__facts, .faq__content, .local__areas').forEach((widget) => {
          gsap.fromTo(widget.children, { opacity: .65, y: 10 }, {
            opacity: 1, y: 0, duration: .55, stagger: .07,
            ease: 'power2.out', immediateRender: false,
            scrollTrigger: { trigger: widget, start: 'top 88%', once: true },
          });
        });

        // Long sections reveal each item when it arrives, rather than playing
        // every widget's animation while later items are still off screen.
        document.querySelectorAll<HTMLElement>('.process__step > div, .lookbook__slide figcaption, .request-booking__note').forEach((widget) => {
          gsap.fromTo(widget, { y: 12 }, {
            y: 0, duration: .65, ease: 'power2.out', immediateRender: false,
            scrollTrigger: { trigger: widget, start: 'top 92%', once: true },
          });
        });

        // Decorative image motion stays inside clipped frames. Text and forms
        // remain stationary, and touch layouts keep the static composition.
        if (desktop) {
          const parallax = (selector: string, travel: number, scale: number) => {
            gsap.utils.toArray<HTMLImageElement>(selector).forEach((image) => {
              const frame = image.parentElement;
              if (!frame) return;
              gsap.fromTo(image, { yPercent: -travel, scale }, {
                yPercent: travel, scale, ease: 'none',
                scrollTrigger: { trigger: frame.closest('[data-process]') ?? frame, start: 'top bottom', end: 'bottom top', scrub: .7 },
              });
            });
          };
          parallax('.section-photo__frame > img', 3, 1.02);
          parallax('.hero__media > img', 2, 1.08);
          parallax('.lookbook__image > img', 2, 1.08);
          parallax('.process__visual > img', 3, 1.02);
          gsap.fromTo('.about__mark', { rotation: -5 }, {
            rotation: 5, ease: 'none',
            scrollTrigger: { trigger: '.about', start: 'top bottom', end: 'bottom top', scrub: 1 },
          });
        }
      });

      const refresh = () => ScrollTrigger.refresh();
      if (document.readyState !== 'complete') window.addEventListener('load', refresh, { once: true });
      void document.fonts.ready.then(refresh);
      window.addEventListener('pagehide', () => {
        window.removeEventListener('load', refresh);
        media?.revert();
      }, { once: true });
    } catch {
      media?.revert();
      // Static content is the complete fallback when motion cannot initialise.
    }
  }

  window.addEventListener('pageshow', (event) => { if (event.persisted) void initialiseMotion(); });
  void initialiseMotion();
</script>
