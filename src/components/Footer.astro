---
import BrandLogo from './BrandLogo.astro';
import type { SiteConfig } from '../data/site';
import { pricingDraft } from '../data/pricing';

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const onHome = Astro.url.pathname === '/';
const showPricing = import.meta.env.DEV || pricingDraft.approved;
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <BrandLogo compact />
    <p>European-style dry manicures, structured gel and nail art with Bianca Ashley in Scarborough. Appointments by request.</p>
  </div>
  <div class="site-footer__links">
    <a href={onHome ? '#service' : '/#service'}>Manicure options</a>
    {showPricing && <a href="/services-pricing">Services &amp; Pricing</a>}
    <a href={onHome ? '#about' : '/#about'}>About Bianca</a>
    <a href={onHome ? '#visit' : '/#visit'}>Visiting from the GTA</a>
    <a href={onHome ? '#booking' : '/#booking'} data-analytics-events="booking_request_view">Request an appointment</a>
    <a href="/privacy">Privacy notice</a>
    {site.socials.map((social) => <a href={social.href}>{social.label}</a>)}
    {site.googleBusinessUrl && <a href={site.googleBusinessUrl}>Google Business Profile</a>}
  </div>
  <div class="site-footer__details">
    {site.location.displayName && <p>{site.location.displayName}</p>}
    {site.hours.map((hours) => <p>{hours}</p>)}
    {site.contact && <a href={site.contact.href} data-analytics-events={`${site.contact.type}_click`}>{site.contact.label}</a>}
    <p>By appointment.</p>
    <p class="site-footer__copyright">© {new Date().getFullYear()} {site.businessName}</p>
  </div>
</footer>
