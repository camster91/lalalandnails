---
import SectionPhoto from './SectionPhoto.astro';
import { siteConfig } from '../data/site';
---
<section class="request-booking section" id="booking" aria-labelledby="request-title">
  <div class="request-booking__intro reveal">
    <p class="eyebrow">Request an appointment</p>
    <h2 id="request-title">Your next manicure <em>starts here.</em></h2>
    <p>A shape you love. A colour you keep saving. Tell Bianca what you have in mind.</p>

    <div class="request-booking__note"><span aria-hidden="true">↗</span><p><strong>One conversation to get started.</strong><br />Choose a two-hour block, then leave your number. Bianca will call or text to confirm the service, price and visit details.</p></div>
    <SectionPhoto photo="neutral" caption="Your next manicure starts with a conversation. " aspect="wide" />
  </div>

  <div class="booking-form-home" data-booking-home>
  <form class="booking-form" data-booking-form action="/api/bookings" method="post" novalidate>
    <input type="hidden" name="leadSource" value="unknown" />
    <p class="booking-form__intro">Monday–Friday, 10 a.m.–3 p.m. Toronto time. One appointment per day. Fields marked * are required.</p>
    <div class="booking-calendar" data-booking-calendar tabindex="-1" aria-describedby="preferredDate-error preferredTime-error">
      <input type="hidden" name="preferredDate" />
      <details open>
        <summary>Choose a date and time</summary>
        <p class="field-hint">Two-hour blocks · Monday–Friday · 10 a.m.–3 p.m. · Toronto time. A submitted request reserves that day for review.</p>
        <div class="booking-calendar__heading"><button type="button" data-calendar-previous aria-label="Previous month" disabled>←</button><strong data-calendar-month>Available dates</strong><button type="button" data-calendar-next aria-label="Next month" disabled>→</button></div>
        <div class="booking-calendar__weekdays" aria-hidden="true"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
        <div class="booking-calendar__days" data-calendar-days role="group" aria-label="Available appointment dates"></div>
        <p class="field-hint" data-calendar-notice role="status">Loading available dates…</p>
        <button type="button" class="text-link" data-calendar-retry hidden>Retry calendar</button>
        <label>Two-hour block · Toronto time <span aria-hidden="true">*</span><select name="preferredTime" required disabled aria-describedby="preferredTime-error"><option value="">Choose a date first</option></select></label>
        <button type="button" class="button" data-calendar-use disabled>Use this time</button>
      </details>
      <span id="preferredDate-error" class="field-error" data-field-error="preferredDate"></span>
      <span id="preferredTime-error" class="field-error" data-field-error="preferredTime"></span>
    </div>
    <div class="booking-form__honeypot" aria-hidden="true">
      <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <label>
      Full name <span aria-hidden="true">*</span>
      <input name="name" autocomplete="name" minlength="2" maxlength="80" required aria-describedby="name-error" />
      <span id="name-error" class="field-error" data-field-error="name"></span>
    </label>

    <label>
      Phone number <span aria-hidden="true">*</span>
      <input name="phone" type="tel" autocomplete="tel" maxlength="40" required aria-describedby="contact-hint phone-error" />
    </label>
    <span id="phone-error" class="field-error" data-field-error="phone"></span>
    <p class="field-hint" id="contact-hint">Canadian or US number, including area code. Use a mobile number for a text back.</p>

    <label>
      How should we get back to you? <span aria-hidden="true">*</span>
      <select name="contactMethod" required aria-describedby="contactMethod-error">
        <option value="text">Text me</option>
        <option value="call">Call me</option>
      </select>
    </label>

    <span id="contactMethod-error" class="field-error" data-field-error="contactMethod"></span>

    <label>
      What do you have in mind? <span class="field-optional">Optional</span>
      <textarea name="notes" rows="4" maxlength="600" placeholder="Your preferred length or colour, any gel or extensions already on your nails, or a question for Bianca."></textarea>
    </label>

    <label class="booking-form__consent">
      <input name="consent" type="checkbox" required aria-describedby="consent-error" />
      <span>I agree that La La Land may use these details to respond to this appointment request. <span aria-hidden="true">*</span></span>
    </label>

    <span id="consent-error" class="field-error" data-field-error="consent"></span>
    <p class="field-hint">Please keep notes appointment-related and leave out medical information.</p>
    <button class="button button--cream" type="submit">Request a call or text</button>
    <p class="field-hint">Your appointment is confirmed only after you agree on the details with Bianca.</p>
    <p class="field-hint">Read our <a href="/privacy">privacy notice</a>.</p>
    {siteConfig.contact && <p class="field-hint">Prefer to contact us directly? <a href={siteConfig.contact.href}>{siteConfig.contact.label}</a></p>}
    <p class="booking-form__status" data-booking-status role="status" aria-live="polite"></p>
  </form>
  </div>
</section>
<dialog id="booking-dialog" class="booking-dialog" data-booking-dialog aria-labelledby="booking-dialog-title" aria-describedby="booking-dialog-description">
  <div class="booking-dialog__header">
    <div><p class="eyebrow">La La Land Nail Hub</p><h2 id="booking-dialog-title">Request an appointment</h2></div>
    <button type="button" class="booking-dialog__close" data-booking-close aria-label="Close appointment request">×</button>
  </div>
  <p id="booking-dialog-description" class="booking-dialog__description">Choose a two-hour block. Bianca will call or text to confirm your request.</p>
  <div data-booking-dialog-body></div>
</dialog>

<script>
  import { startBooking } from '../scripts/booking';
  startBooking();
</script>
