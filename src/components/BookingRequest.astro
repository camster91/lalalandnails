<section class="request-booking section" id="booking" aria-labelledby="request-title">
  <div class="request-booking__intro reveal">
    <p class="eyebrow">Request an appointment</p>
    <h2 id="request-title">Your next manicure <em>starts here.</em></h2>
    <p>Choose a preferred date and time. La La Land will review your request and contact you before the appointment is confirmed.</p>

    <div class="request-booking__note"><span aria-hidden="true">↗</span><p><strong>A request, then a confirmation.</strong><br />Your preferred date is a starting point. Please wait for La La Land to confirm your appointment before making plans to visit.</p></div>
  </div>

  <form class="booking-form reveal" data-booking-form action="/api/bookings" method="post" novalidate>
    <div class="booking-form__honeypot" aria-hidden="true">
      <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <label>
      Full name <span aria-hidden="true">*</span>
      <input name="name" autocomplete="name" maxlength="80" required />
    </label>

    <fieldset class="booking-form__contact" aria-describedby="contact-hint">
      <legend>How should La La Land contact you?</legend>
      <div class="booking-form__split">
        <label>
          Email
          <input name="email" type="email" autocomplete="email" maxlength="120" aria-describedby="contact-hint" />
        </label>
        <label>
          Phone
          <input name="phone" type="tel" autocomplete="tel" maxlength="40" aria-describedby="contact-hint" />
        </label>
      </div>
      <p class="field-hint" id="contact-hint">Provide at least one way to contact you.</p>
    </fieldset>

    <div class="booking-form__split">
      <label>
        Preferred date <span aria-hidden="true">*</span>
        <input name="preferredDate" type="date" required data-preferred-date />
      </label>
      <label>
        Time preference <span aria-hidden="true">*</span>
        <select name="preferredTime" required>
          <option value="">Choose one</option>
          <option value="morning">Morning</option>
          <option value="afternoon">Afternoon</option>
          <option value="evening">Evening</option>
          <option value="flexible">Flexible</option>
        </select>
      </label>
    </div>

    <label>
      What do you have in mind? <span class="field-optional">Optional</span>
      <textarea name="notes" rows="4" maxlength="600" placeholder="A colour idea, your preferred style or a question about your appointment."></textarea>
    </label>

    <label class="booking-form__consent">
      <input name="consent" type="checkbox" required />
      <span>I agree that La La Land may use these details to respond to this appointment request.</span>
    </label>

    <p class="field-hint">Please keep notes appointment-related and leave out medical information.</p>
    <button class="button button--cream" type="submit">Send appointment request</button>
    <p class="booking-form__status" data-booking-status role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
  const status = form?.querySelector<HTMLElement>('[data-booking-status]');
  const dateInput = form?.querySelector<HTMLInputElement>('[data-preferred-date]');

  if (dateInput) {
    const today = new Date();
    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, '0');
    const day = String(today.getDate()).padStart(2, '0');
    dateInput.min = `${year}-${month}-${day}`;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = form.elements.namedItem('email') as HTMLInputElement | null;
    const phone = form.elements.namedItem('phone') as HTMLInputElement | null;
    const hasContact = Boolean(email?.value.trim() || phone?.value.trim());
    email?.setAttribute('aria-invalid', String(!hasContact));
    phone?.setAttribute('aria-invalid', String(!hasContact));
    if (!hasContact) {
      if (status) status.textContent = 'Provide an email address or phone number so La La Land can respond.';
      email?.focus();
      return;
    }
    if (!form.reportValidity()) return;

    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    if (status) status.textContent = 'Sending your request…';

    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const result = await response.json() as { ok?: boolean; message?: string; errors?: Record<string, string> };
      if (!response.ok || !result.ok) throw new Error(result.message || Object.values(result.errors ?? {})[0] || 'The request could not be sent.');

      form.reset();
      if (status) status.textContent = result.message ?? 'Your request has been received.';
      window.plausible?.('booking_request_submitted');
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : 'The request could not be sent.';
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
