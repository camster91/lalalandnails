---
import { pricingDraft as prices, displayPrice } from '../data/pricing';
---
<section class="pricing-teaser section" id="pricing" aria-labelledby="pricing-teaser-title">
  <div class="pricing-teaser__heading">
    <div>
      <p class="eyebrow">A simple way to plan</p>
      <h2 id="pricing-teaser-title">Services & <em>pricing.</em></h2>
    </div>
    <p>Find the right manicure, then choose your natural nail length and design. We confirm the final service and price before your appointment.</p>
  </div>
  <div class="pricing-teaser__grid">
    {prices.manicures.map((service) => (
      <article class="pricing-teaser__card">
        <h3>{service.name}</h3>
        <strong>{displayPrice(service.price)}</strong>
        <p>{service.description}</p>
      </article>
    ))}
  </div>
  <div class="pricing-teaser__bottom">
    <p>{prices.approved ? 'Starting prices in CAD. Length, art and repairs may be additional.' : 'Proposed starting prices in CAD · Pending studio approval.'}</p>
    <a class="button" href="/services-pricing">Explore all services & pricing</a>
  </div>
</section>

<style>
  .pricing-teaser { background: var(--blush-light); }
  .pricing-teaser__heading { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: end; margin-bottom: 2.5rem; }
  .pricing-teaser__heading h2 { font-size: clamp(2.8rem, 5vw, 5rem); }
  .pricing-teaser__heading > p { max-width: 33rem; margin: 0; line-height: 1.7; }
  .pricing-teaser__grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .pricing-teaser__card { display: flex; flex-direction: column; min-width: 0; padding: clamp(1.5rem,3vw,2.5rem); background: var(--paper); border-radius: var(--radius); }
  .pricing-teaser__card h3 { font-size: 1.1rem; line-height: 1.45; }
  .pricing-teaser__card strong { margin-top: 1.4rem; font: 400 clamp(2rem,3vw,3rem)/1 var(--serif); }
  .pricing-teaser__card p { margin: 1.2rem 0 0; line-height: 1.6; }
  .pricing-teaser__bottom { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; margin-top: 2rem; }
  .pricing-teaser__bottom p { margin: 0; font-size: .875rem; line-height: 1.6; }
  @media (max-width: 900px) { .pricing-teaser__heading { grid-template-columns: 1fr; gap: 1.2rem; } }
  @media (max-width: 720px) { .pricing-teaser__grid { grid-template-columns: 1fr; } .pricing-teaser__bottom { flex-direction: column; align-items: flex-start; } }
</style>
