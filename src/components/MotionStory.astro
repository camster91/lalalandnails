---
import { imagery } from '../data/imagery';
const photos = [imagery.red, imagery.neutral, imagery.colour, imagery.care, imagery.detail];
---
<section class="lookbook section" id="looks" aria-labelledby="looks-title" data-lookbook>
  <div class="lookbook__heading reveal">
    <div><p class="eyebrow">Manicure colour & design ideas</p><h2 id="looks-title">Find your next<br /><em>nail mood.</em></h2></div>
    <div class="lookbook__intro"><p>Explore a few colours and finishes, then add your own inspiration to the request. Bianca reviews the design and confirms what suits your natural nails.</p><div class="lookbook__controls"><button type="button" aria-label="Previous inspiration image" data-slide-prev>←</button><button type="button" aria-label="Next inspiration image" data-slide-next>→</button><span>Swipe or use the arrows</span></div></div>
  </div>
  <div class="lookbook__rail" data-slide-rail tabindex="0" role="region" aria-label="Manicure inspiration images. Use arrow keys or swipe to browse.">
    {photos.map((photo, index) => <figure class="lookbook__slide"><div class="lookbook__image"><img src={`/images/generated/${photo.id}-1440.webp`} srcset={`/images/generated/${photo.id}-720.webp 720w, /images/generated/${photo.id}-1440.webp 1440w`} sizes="(max-width: 640px) 78vw, (max-width:900px) 46vw, 430px" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" /></div><figcaption><span>{String(index+1).padStart(2,'0')} / {photo.title}</span><small>AI-generated inspiration</small></figcaption></figure>)}
  </div>
  <p class="lookbook__disclosure">AI-generated images grounded in real manicure references, shown for inspiration. These are not Bianca’s client work or photographs of the studio. Discuss your reference ideas and the available options before confirming.</p>
</section>
<script>
  const book = document.querySelector<HTMLElement>('[data-lookbook]');
  const rail = book?.querySelector<HTMLElement>('[data-slide-rail]');
  const prev = book?.querySelector<HTMLButtonElement>('[data-slide-prev]');
  const next = book?.querySelector<HTMLButtonElement>('[data-slide-next]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const update = () => {
    if (!rail) return;
    if (prev) prev.disabled = rail.scrollLeft <= 2;
    if (next) next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
  };
  const slide = (direction: number) => {
    if (!rail) return;
    const card = rail.querySelector<HTMLElement>('.lookbook__slide');
    const gap = Number.parseFloat(getComputedStyle(rail).columnGap) || 0;
    rail.scrollBy({left: direction * ((card?.offsetWidth ?? rail.clientWidth) + gap), behavior: reduced.matches ? 'instant' : 'smooth'});
  };
  prev?.addEventListener('click', () => slide(-1));
  next?.addEventListener('click', () => slide(1));
  rail?.addEventListener('scroll', update, {passive:true});
  rail?.addEventListener('keydown', event => {
    if (event.target !== rail) return;
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); slide(event.key === 'ArrowLeft' ? -1 : 1); }
  });
  window.addEventListener('resize', update);
  update();
</script>
