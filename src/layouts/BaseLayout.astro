---
import '../styles/global.css';
import AnalyticsChoice from '../components/AnalyticsChoice.astro';
import { homeMetadata, type SiteConfig } from '../data/site';
import { buildSchema, isIndexable, serializeSchema } from '../lib/seo';

interface Props {
  site: SiteConfig;
  photo?: { img: string; alt: string };
  title?: string;
  notFound?: boolean;
  description?: string;
}

const {
  site,
  title = homeMetadata.title,
  description = homeMetadata.description,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, site.approvedDomain ?? site.canonicalOrigin).toString();
const socialImage = new URL(Astro.props.photo?.img ?? '/images/generated/red-1440.webp', site.approvedDomain ?? site.canonicalOrigin).toString();
const indexable = isIndexable(site, Astro.url);
const publicProduction = Astro.url.origin === 'https://lalalandnails.ca'
  && !/^\/(admin|api|calendar|studio-preview|studio-review|signin-with-chatgpt)(?:\/|$)/i.test(Astro.url.pathname);
const publicPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const schema = Astro.url.pathname === '/' ? buildSchema(site) : null;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#330505" />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.businessName} />
    <meta property="og:image" content={socialImage} />
    {!Astro.props.photo && <meta property="og:image:width" content="1440" />}
    {!Astro.props.photo && <meta property="og:image:height" content="1800" />}
    <meta property="og:image:alt" content={Astro.props.photo?.alt ?? "AI-generated burgundy manicure inspiration; not La La Land client work"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={Astro.props.photo?.alt ?? "AI-generated burgundy manicure inspiration; not La La Land client work"} />
    <link rel="icon" href="/brand/submark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="mask-icon" href="/brand/submark.svg" color="#330505" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    {site.analytics.domain && (
      <script is:inline defer data-domain={site.analytics.domain} src="https://plausible.io/js/script.js"></script>
    )}
    {schema && <script is:inline type="application/ld+json" set:html={serializeSchema(schema)} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    {publicProduction &&
      <AnalyticsChoice measurementId="G-SN2ZY23TZP" pagePath={Astro.props.notFound ? '/404' : publicPath} />}
    <script>
      import { rememberVisitSource } from '../lib/lead-source';
      rememberVisitSource();
    </script>
    {site.analytics.domain && <script is:inline>
      window.plausible = window.plausible || function () {
        (window.plausible.q = window.plausible.q || []).push(arguments);
      };

      document.addEventListener('click', function (event) {
        const target = event.target instanceof Element ? event.target.closest('[data-analytics-events]') : null;
        if (!target) return;
        const events = (target.getAttribute('data-analytics-events') || '').split(/\s+/).filter(Boolean);
        events.forEach(function (name) { window.plausible(name); });
      });

      document.querySelectorAll('[data-faq]').forEach(function (details) {
        details.addEventListener('toggle', function () {
          if (details.open) window.plausible('faq_engagement');
        });
      });
    </script>}
  </body>
</html>
