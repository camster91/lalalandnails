{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lalalandnails",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lalalandnails",
      "database_id": "51ca47db-6fd4-4f57-8d6c-c03e34b13a48"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "925b577f8134421b8f46dffda7a5d313"
    }
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "lalalandnails.ca",
      "custom_domain": true
    },
    {
      "pattern": "www.lalalandnails.ca",
      "custom_domain": true
    }
  ],
  "send_email": [
    {
      "name": "BOOKING_EMAIL"
    }
  ],
  "previews": {
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "4de6fb2d65914c7ba0f1031f5afe0153"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "lalalandnails-preview",
        "database_id": "f5786b9a-aee7-40f0-a63b-7d5e414773b6"
      }
    ],
    "images": {
      "binding": "IMAGES"
    },
    "send_email": []
  }
}
